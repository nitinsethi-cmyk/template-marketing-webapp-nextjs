BUNDLE_ANALYZE=false
ENVIRONMENT_NAME=local

# The URL for the domain your app is hosted on (used for generating the urls needed for SEO)
# If you deploy to Vercel or Netlify it is configured through the respective config files (`vercel.json` and `netlify.toml`)
NEXT_PUBLIC_BASE_URL=http://localhost:3000/

# Your current space ID: https://www.contentful.com/help/find-space-id/
CONTENTFUL_SPACE_ID=

# Your current space Content Delivery API access token: https://www.contentful.com/developers/docs/references/content-delivery-api/
CONTENTFUL_ACCESS_TOKEN=

# Your current space Content Preview API access token: https://www.contentful.com/developers/docs/references/content-preview-api/
CONTENTFUL_PREVIEW_ACCESS_TOKEN=

# Amplitude Experiment deployment key (client-side)
# https://amplitude.com/docs/feature-experiment/local-evaluation/implementation
NEXT_PUBLIC_AMPLITUDE_EXPERIMENT_DEPLOYMENT_KEY=

# Optional: server deployment key for SSR remote evaluation.
# Falls back to NEXT_PUBLIC_AMPLITUDE_EXPERIMENT_DEPLOYMENT_KEY when unset.
# https://amplitude.com/docs/feature-experiment/advanced-techniques/server-side-rendering
AMPLITUDE_EXPERIMENT_SERVER_DEPLOYMENT_KEY=

# Optional: force Wrangler/esbuild to prefer Node package exports (Cloudflare Workers Builds)
# WRANGLER_BUILD_CONDITIONS=
# WRANGLER_BUILD_PLATFORM=node
